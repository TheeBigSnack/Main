# Copy this file to backend/.env and fill it in. Never commit .env.

# From https://console.anthropic.com/ -> API keys. Required.
ANTHROPIC_API_KEY=sk-ant-...

# Shared secret the extension must send (Settings -> Description writer -> Service key).
# Any long random string. Leave empty only when the service runs on your own machine.
REWRITE_KEY=

# claude-haiku-4-5 (default: cheap and fast) or claude-sonnet-5.
# claude-haiku-4-5-20251001 pins the dated snapshot of the same model.
REWRITE_MODEL=claude-haiku-4-5

# Safety rails
MONTHLY_COST_CAP_USD=25
RATE_LIMIT_PER_MINUTE=20
PORT=8787
# Address to listen on: 127.0.0.1 = this machine only; 0.0.0.0 = the whole network (REWRITE_KEY is then required).
HOST=127.0.0.1
